# Copy to `.env` for local development:  cp .env.example .env
#
# Every setting here maps to a field in `crates/server/src/config.rs`. The
# `AUTHENC_` prefix plus `__` for nesting is the whole convention:
# `AUTHENC_SERVER__PORT` sets `config.server.port`.
#
# Settings are read once at startup and validated. Under the `production`
# profile the server refuses to start on a weak configuration rather than
# falling back to a default.

# --- required by the sqlx compile-time query macros and by sqlx-cli ----------
# Read directly by `cargo sqlx prepare` and `sqlx migrate run`; not part of the
# AUTHENC_ namespace.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/authenc

# --- profile ----------------------------------------------------------------
# development | test | production
AUTHENC_PROFILE=development

# --- server -----------------------------------------------------------------
AUTHENC_SERVER__HOST=127.0.0.1
AUTHENC_SERVER__PORT=3000
# Must be https:// under the production profile.
AUTHENC_SERVER__PUBLIC_URL=http://localhost:3000
AUTHENC_SERVER__REQUEST_TIMEOUT=30
AUTHENC_SERVER__MAX_BODY_BYTES=1048576

# --- database ---------------------------------------------------------------
AUTHENC_DATABASE__URL=postgres://postgres:postgres@localhost:5432/authenc
AUTHENC_DATABASE__MAX_CONNECTIONS=16
AUTHENC_DATABASE__MIN_CONNECTIONS=1
AUTHENC_DATABASE__ACQUIRE_TIMEOUT=5
AUTHENC_DATABASE__MIGRATE_ON_START=true

# --- telemetry --------------------------------------------------------------
AUTHENC_TELEMETRY__FILTER=info,authenc=debug,tower_http=debug
# Set true in production so logs are machine-readable.
AUTHENC_TELEMETRY__JSON=false
# RUST_LOG, when set, overrides AUTHENC_TELEMETRY__FILTER.
# RUST_LOG=debug

# --- security ---------------------------------------------------------------
# Comma-separated. Empty means same-origin only, which is the right default.
# `*` is rejected under the production profile.
AUTHENC_SECURITY__CORS_ALLOWED_ORIGINS=
# Must be true under the production profile.
AUTHENC_SECURITY__HSTS=false

# --- cargo-leptos runtime ---------------------------------------------------
# Set by `cargo leptos serve`; needed only when running the binary directly.
LEPTOS_OUTPUT_NAME=authenc
LEPTOS_SITE_ROOT=target/site
LEPTOS_SITE_PKG_DIR=pkg
LEPTOS_SITE_ADDR=127.0.0.1:3000
