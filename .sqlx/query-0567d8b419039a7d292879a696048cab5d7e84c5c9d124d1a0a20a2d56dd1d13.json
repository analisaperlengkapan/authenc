  "query": "\n        SELECT user_id, realm_id, scopes, expires_at\n        FROM refresh_tokens\n        WHERE token_hash = $1\n          AND client_id = $2\n          AND used_at IS NULL\n          AND revoked_at IS NULL\n          AND expires_at > now()\n        ",
