  "db_name": "PostgreSQL",
  "query": "\n        SELECT f.provider_id, f.user_id, f.upstream_email, f.linked_at,\n               f.last_login_at, p.alias, p.display_name\n          FROM federated_identities f\n          JOIN identity_providers p ON p.id = f.provider_id\n         WHERE f.user_id = $1\n         ORDER BY p.display_name\n        ",
