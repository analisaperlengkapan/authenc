  "query": "\n        UPDATE refresh_tokens\n        SET used_at = now()\n        WHERE token_hash = $1\n          AND client_id = $2\n          AND used_at IS NULL\n          AND revoked_at IS NULL\n          AND expires_at > now()\n        RETURNING id, realm_id, user_id, scopes, family_id, authenticated_with\n        ",
