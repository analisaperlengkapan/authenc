  "query": "\n        UPDATE authorization_codes\n        SET used_at = now()\n        WHERE code_hash = $1 AND client_id = $2 AND used_at IS NULL\n        RETURNING id, realm_id, user_id, redirect_uri, scopes, nonce,\n                  code_challenge, expires_at, authenticated_with\n        ",
