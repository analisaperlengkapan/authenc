  "query": "\n        INSERT INTO roles (realm_id, name, description)\n        VALUES ($1, $2, $3)\n        ON CONFLICT (realm_id, name)\n            DO UPDATE SET description = COALESCE(EXCLUDED.description, roles.description)\n        RETURNING id, realm_id, name, description\n        ",
