  "query": "\n        SELECT id, realm_id, username, email, email_verified,\n               first_name, last_name, enabled, created_at\n        FROM users\n        WHERE realm_id = $1\n        ORDER BY lower(username)\n        LIMIT $2 OFFSET $3\n        ",
